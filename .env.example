# Fairhold environment variables. Copy to .env.local for local overrides; never commit real values.
# Keyless local mode needs none of these: outside production, the app falls back to the local
# database (npm run db:start), simulated payments, recorded Glim replies and placeholder secrets.

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:54329/fairhold_dev

# Payments: simulated (no keys) or sandbox (calls the PayPal sandbox). Live PayPal is not supported.
PAYMENTS_MODE=simulated
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Glim: recorded (replays stored replies) or live (calls Claude).
GLIM_MODE=recorded
ANTHROPIC_API_KEY=
# Tokens Glim may spend per UTC day across every event (default 1000000)
GLIM_DAILY_TOKEN_BUDGET=

# At least 32 random characters each, for example: openssl rand -base64 32
SESSION_SECRET=
CRON_SECRET=

# PayPal sandbox buyer logins shown on the home page (sandbox test accounts only)
DEMO_BUYER_1_EMAIL=
DEMO_BUYER_1_PASSWORD=
DEMO_BUYER_2_EMAIL=
DEMO_BUYER_2_PASSWORD=
DEMO_BUYER_3_EMAIL=
DEMO_BUYER_3_PASSWORD=

# AG Studio trial license; public, inlined into the browser bundle at build time
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# Run the engine tick inside the web process (true on Render)
ENGINE_ENABLED=false
# Glim's autopilot: on (default) lets Glim change a confirmed plan on its own, inside the guest's
# rules; off keeps plans as confirmed. It runs only where ENGINE_ENABLED=true.
GLIM_AUTOPILOT=on

# Design and visual checks only; production ignores both.
# UI_FIXTURE=riverside renders the guest pages from the built-in fixture, without a database.
UI_FIXTURE=
# Freezes the guest pages' clock at an ISO instant; npm run db:seed prints the one to use.
FREEZE_CLOCK_AT=
